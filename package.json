    "eslint": "8.57.1",
    "npm-run-all": "4.1.5",
    "prisma": "6.2.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "3.0.4"
  },
  "dependencies": {
